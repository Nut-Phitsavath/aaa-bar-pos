DATABASE_URL="file:./dev.db"

# Signs the login cookie (lib/session.ts). At least 32 characters, random, and
# never committed. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Changing it signs everyone out. On the till, FIRST-TIME-SETUP.bat writes a
# .env with one of its own; updates never replace it.
SESSION_SECRET=""
