DATABASE_URL="file:./dev.db"

# Signs the login cookie (lib/session.ts). At least 32 characters, random, and
# never committed. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Changing it signs everyone out. build-deploy.ps1 adds one to the till's .env
# if it is missing.
SESSION_SECRET=""
